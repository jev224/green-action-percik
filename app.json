{
  "expo": {
    "name": "starter-kit-expo-uniwind",
    "slug": "starter-kit-expo-uniwind",
    "version": "1.0.0",
    "scheme": "green-action",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.anonymous.starter-kit-expo-uniwind"
    },
    "android": {
      "package": "com.anonymous.starterkitexpouniwind",
      "predictiveBackGestureEnabled": true
    },
    "web": {
      "bundler": "metro",
      "output": "static"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "@react-native-community/datetimepicker"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
