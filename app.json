{
	"expo": {
		"name": "Green Action",
		"slug": "green-action-percik",
		"description": "Platform edukasi pengolahan sampah untuk menciptakan lingkungan sekolah yang bersih, hijau, sehat, dan berkelanjutan",
		"version": "1.0.0",
		"orientation": "portrait",
		"icon": "./assets/icons/icon.png",
		"scheme": "green-action.percik",
		"userInterfaceStyle": "automatic",
		"platforms": ["android", "web"],
		"android": {
			"package": "app.percik.greenaction",
			"softwareKeyboardLayoutMode": "resize",
			"predictiveBackGestureEnabled": true,
			"permissions": ["android.permission.REQUEST_INSTALL_PACKAGES"],
			"adaptiveIcon": {
				"backgroundImage": "./assets/icons/android/android-icon-background.png",
				"foregroundImage": "./assets/icons/android/android-icon-foreground.png",
				"monochromeImage": "./assets/icons/android/android-icon-monochrome.png"
			}
		},
		"web": {
			"output": "static",
			"favicon": "./assets/icons/favicon.png"
		},
		"plugins": [
			"expo-router",
			"expo-dev-client",
			[
				"expo-splash-screen",
				{
					"image": "./assets/icons/splash-icon.png",
					"resizeMode": "contain",
					"backgroundColor": "#ffffff"
				}
			],
			"expo-secure-store",
			["expo-image", { "disableLibdav1d": true }],
			"expo-sharing",
			[
				"expo-build-properties",
				{
					"android": {
						"buildArchs": ["armeabi-v7a", "arm64-v8a"],
						"enableProguardInReleaseBuilds": true,
						"enableShrinkResourcesInReleaseBuilds": true,
						"useLegacyPackaging": true
					}
				}
			]
		],
		"experiments": {
			"typedRoutes": true
		}
	}
}
