{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "green-action",
	"main": "worker/index.js",
	"compatibility_date": "2026-10-19",
	"observability": {
		"enabled": true
	},
	"assets": {
		"directory": "dist",
		"binding": "ASSETS",
		"not_found_handling": "single-page-application",
		"run_worker_first": ["/manifest"]
	}
}
